graph TB
    subgraph "Capa de Presentación"
        User[👤 Usuario ALSEA]
        Angular[🖥️ Cliente Web<br/>Angular 15 + TypeScript]
        ReportGen[📝 Report Generator<br/>Component]
        History[📋 History<br/>Component]
        ReportService[⚙️ Report Service]
    end

    subgraph "Capa de Aplicación - Spring Boot"
        API[🌐 API REST<br/>Controllers]
        ReportController[📡 ReportController]
        BatchService[⚡ Batch Service]
        ReportRepo[💾 Report Repository]
        
        subgraph "Spring Batch"
            JobLauncher[🚀 Job Launcher]
            GenerateJob[📊 Generate Report Job]
            GenerateStep[⚙️ Generate Report Step]
            ExcelGen[📄 Excel Generator<br/>Aspose Cells]
        end
    end

    subgraph "Capa de Datos"
        PostgreSQL[(🗄️ PostgreSQL<br/>alsea_reports)]
        Elasticsearch[(🔍 Elasticsearch<br/>Process Variables)]
        BICProcessDB[(📦 BIC Process<br/>Execution DB)]
    end

    subgraph "Infraestructura"
        Flyway[🔄 Flyway<br/>Migrations]
        Docker[🐳 Docker<br/>Containers]
        AWX[⚙️ AWX/Ansible<br/>Deployment]
    end

    %% Flujo de usuario
    User -->|Interactúa| Angular
    Angular --> ReportGen
    Angular --> History
    ReportGen --> ReportService
    History --> ReportService
    
    %% Comunicación API
    ReportService -->|HTTP/JSON| API
    API --> ReportController
    
    %% Generación de informes
    ReportController -->|Verifica duplicados| ReportRepo
    ReportController -->|Lanza Job| JobLauncher
    JobLauncher --> GenerateJob
    GenerateJob --> GenerateStep
    
    %% Acceso a datos
    GenerateStep -->|Lee variables| Elasticsearch
    GenerateStep -->|Lee datos procesos| BICProcessDB
    GenerateStep -->|Genera Excel| ExcelGen
    GenerateStep -->|Persiste| ReportRepo
    
    %% Repositorio
    ReportRepo -->|CRUD| PostgreSQL
    
    %% Historial
    ReportController -->|Lista informes| ReportRepo
    ReportController -->|Descarga| ReportRepo
    
    %% Respuesta al cliente
    ReportController -->|Stream binario| ReportService
    ReportService -->|Descarga Excel| Angular
    
    %% Infraestructura
    Flyway -.->|Gestiona esquema| PostgreSQL
    Docker -.->|Contiene| Angular
    Docker -.->|Contiene| API
    AWX -.->|Despliega| Docker

    classDef frontend fill:#4A90E2,stroke:#2E5C8A,color:#fff
    classDef backend fill:#50C878,stroke:#2E7D4E,color:#fff
    classDef database fill:#F5A623,stroke:#C17D11,color:#fff
    classDef batch fill:#9013FE,stroke:#6B0FC4,color:#fff
    classDef infra fill:#7B68EE,stroke:#5B4BB8,color:#fff

    class User,Angular,ReportGen,History,ReportService frontend
    class API,ReportController,BatchService,ReportRepo backend
    class JobLauncher,GenerateJob,GenerateStep,ExcelGen batch
    class PostgreSQL,Elasticsearch,BICProcessDB database
    class Flyway,Docker,AWX infra
